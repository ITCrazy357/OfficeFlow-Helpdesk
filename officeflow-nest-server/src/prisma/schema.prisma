generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  MANAGER
  IT_STAFF
  EMPLOYEE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketHistoryAction {
  CREATE
  UPDATE
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
  ATTACHMENT_ADDED
  ATTACHMENT_DELETED
  DELETED
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_COMMENTED
  TICKET_STATUS_CHANGED
  TICKET_OVERDUE
  TICKET_SLA_WARNING
  TICKET_RESPONSE_OVERDUE
  TICKET_SLA_ESCALATED
  KNOWLEDGE_PUBLISHED
  ASSET_ASSIGNED
  ASSET_RETURNED
  ASSET_WARRANTY_EXPIRING
  LEAVE_REQUESTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
}

enum AssetType {
  LAPTOP
  DESKTOP
  MONITOR
  PRINTER
  PHONE
  TABLET
  NETWORK_DEVICE
  ACCESSORY
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
  LOST
}

enum AssetMaintenanceKind {
  MAINTENANCE
  REPAIR
  WARRANTY
}

enum AssetMaintenanceStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum AuditLogEntity {
  USER
  DEPARTMENT
  TICKET
  KNOWLEDGE_ARTICLE
  ASSET
  LEAVE_REQUEST
  SLA_POLICY
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETED
  ASSIGNED
  RETURNED
  STATUS_CHANGED
  ACTIVATED
  DEACTIVATED
  PUBLISHED
  UNPUBLISHED
  LINKED
  UNLINKED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  LEGACY
  ANNUAL
  UNPAID
  SICK
}

enum LeavePeriod {
  FULL_DAY
  MORNING
  AFTERNOON
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Department {
  id   Int    @id @default(autoincrement())
  name String @unique

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Departments")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true)

  isLocked   Boolean   @default(false)
  lockedAt   DateTime?
  lockedById Int?

  unlockedAt   DateTime?
  unlockedById Int?

  mustChangePassword Boolean @default(false)

  managerId    Int?
  manager      User?  @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates User[] @relation("UserManager")

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdTickets  Ticket[] @relation("TicketCreator")
  assignedTickets Ticket[] @relation("TicketAssignee")

  refreshTokens RefreshToken[]

  ticketAttachments TicketAttachment[]

  ticketComments  TicketComment[]
  ticketHistories TicketHistory[]

  knowledgeArticles KnowledgeArticle[]

  notifications Notification[]

  currentAssets Asset[] @relation("CurrentAssetAssignee")

  assetAssignmentsReceived AssetAssignment[] @relation("AssetAssignmentsReceived")

  assetAssignmentsCreated   AssetAssignment[]  @relation("AssetAssignmentsCreated")
  assetMaintenanceCreated   AssetMaintenance[] @relation("AssetMaintenanceCreator")
  assetMaintenanceCompleted AssetMaintenance[] @relation("AssetMaintenanceCompleter")

  auditLogs AuditLog[] @relation("AuditLogActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequestsRequested LeaveRequest[]      @relation("LeaveRequester")
  leaveRequestsToApprove LeaveRequest[]      @relation("LeaveApprover")
  leaveRequestsReviewed  LeaveRequest[]      @relation("LeaveReviewer")
  leaveEntitlements      LeaveEntitlement[]
  ticketFeedbacks        TicketFeedback[]    @relation("FeedbackAuthor")
  supportFeedbacks       TicketFeedback[]    @relation("FeedbackAssignee")
  passwordResetToken     PasswordResetToken?

  @@index([departmentId])
  @@index([role])
  @@index([isActive])
  @@index([managerId])
  @@map("Users")
}

model LeaveRequest {
  id Int @id @default(autoincrement())

  requesterId  Int
  approverId   Int
  reviewedById Int?

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  reason String @db.Text

  type             LeaveType   @default(LEGACY)
  period           LeavePeriod @default(FULL_DAY)
  calendarSnapshot Json?
  days             LeaveDay[]

  status LeaveStatus @default(PENDING)

  reviewNote String?   @db.Text
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester  User  @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  approver   User  @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([requesterId, createdAt])
  @@index([approverId, status, createdAt])
  @@index([requesterId, status, startDate])
  @@index([reviewedById, reviewedAt])
  @@index([status, startDate, endDate])
  @@map("Leave_requests")
}

// Integer half-days avoid rounding. Pending requests reserve the same units
// that approval consumes; cancelled/rejected requests no longer count.
model LeaveDay {
  id        Int          @id @default(autoincrement())
  requestId Int
  request   LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  halfDays  Int

  @@unique([requestId, date])
  @@index([date])
  @@map("Leave_days")
}

model LeaveEntitlement {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  year      Int
  halfDays  Int
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@id([userId, year])
  @@map("Leave_entitlements")
}

model RefreshToken {
  id String @id @default(uuid())

  tokenHash String @unique @db.Char(64)
  familyId  String @db.Char(36)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  replacedById String?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("Refresh_tokens")
}

model TicketCategory {
  id   Int    @id @default(autoincrement())
  name String @unique

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Ticket_categories")
}

model Ticket {
  id          Int            @id @default(autoincrement())
  title       String
  description String         @db.Text
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  dueAt     DateTime? // Hạn xử lý
  resolveAt DateTime? // Thòi điểm xủ lý xong
  isOverdue Boolean   @default(false) // Đã quá hạn hay chưa

  resolutionVersion Int             @default(0)
  confirmedAt       DateTime?
  feedback          TicketFeedback?

  slaPolicy            Json?
  firstResponseDueAt   DateTime?
  firstRespondedAt     DateTime?
  firstResponseOverdue Boolean    @default(false)
  responseWarningAt    DateTime?
  resolutionWarningAt  DateTime?
  slaAlerts            SlaAlert[]

  createdById Int
  createdBy   User @relation("TicketCreator", fields: [createdById], references: [id])

  assignedToId Int?
  assignedTo   User? @relation("TicketAssignee", fields: [assignedToId], references: [id])

  categoryId Int?
  category   TicketCategory? @relation(fields: [categoryId], references: [id])

  assetId Int?
  asset   Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  dueDate DateTime?

  attachments TicketAttachment[]

  comments TicketComment[]

  histories TicketHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([assignedToId])
  @@index([createdById])
  @@index([categoryId])
  @@index([assetId])
  @@index([status, isOverdue, dueAt])
  @@index([status, firstRespondedAt, firstResponseDueAt])
  @@index([status, responseWarningAt])
  @@index([status, resolutionWarningAt])
  @@map("Tickets")
}

model TicketFeedback {
  ticketId          Int      @id
  ticket            Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId          Int
  author            User     @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assignedToId      Int?
  assignedTo        User?    @relation("FeedbackAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  score             Int
  comment           String?  @db.VarChar(2000)
  resolutionVersion Int
  createdAt         DateTime @default(now())

  @@index([authorId])
  @@index([assignedToId, createdAt])
  @@index([createdAt])
  @@map("Ticket_feedbacks")
}

model SlaPolicy {
  id        Int      @id @default(1)
  config    Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("Sla_policies")
}

model SlaAlert {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  milestone String   @db.VarChar(16)
  kind      String   @db.VarChar(16)
  managerId Int?
  createdAt DateTime @default(now())

  @@unique([ticketId, milestone, kind])
  @@map("Sla_alerts")
}

model TicketComment {
  id      Int    @id @default(autoincrement())
  content String @db.Text

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
  @@map("Ticket_comments")
}

model TicketHistory {
  id       Int                 @id @default(autoincrement())
  action   TicketHistoryAction
  oldValue String?
  newValue String?

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([action])
  @@map("Ticket_histories")
}

model TicketAttachment {
  id Int @id @default(autoincrement())

  fileName     String
  fileUrl      String  @db.Text
  fileType     String?
  fileSize     Int?
  publicId     String?
  resourceType String?

  format       String? @db.VarChar(32)
  deliveryType String  @default("upload") @db.VarChar(32)

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  uploadedById Int
  uploadedBy   User @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt, id])
  @@index([uploadedById])
  @@map("Ticket_attachments")
}

model KnowledgeArticle {
  id          Int     @id @default(autoincrement())
  title       String
  slug        String  @unique
  summary     String? @db.Text
  content     String  @db.Text
  tags        String? @db.Text
  isPublished Boolean @default(false)
  viewCount   Int     @default(0)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([isPublished])
  @@index([createdAt])
  @@map("Knowledge_articles")
}

model Notification {
  id      Int              @id @default(autoincrement())
  type    NotificationType
  title   String
  message String           @db.Text
  isRead  Boolean          @default(false)

  targetUrl String?

  sourceEventId String? @db.Char(36)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceEventId, userId, type])
  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("Notifications")
}

model OutboxEvent {
  id               String       @id @default(uuid()) @db.Char(36)
  type             String       @db.VarChar(100)
  payload          Json
  deduplicationKey String       @unique @db.VarChar(191)
  status           OutboxStatus @default(PENDING)
  attempts         Int          @default(0)
  availableAt      DateTime     @default(now())
  lockedAt         DateTime?
  lockedBy         String?      @db.VarChar(100)
  processedAt      DateTime?
  lastError        String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([lockedAt])
  @@map("Outbox_events")
}

model Asset {
  id       Int         @id @default(autoincrement())
  assetTag String      @unique
  name     String
  type     AssetType
  status   AssetStatus @default(AVAILABLE)

  brand        String?
  model        String?
  serialNumber String? @unique

  purchaseDate    DateTime?
  warrantyUntil   DateTime?
  supplierName    String?   @db.VarChar(150)
  supplierContact String?   @db.VarChar(250)
  notes           String?   @db.Text

  assignedToId Int?
  assignedTo   User? @relation("CurrentAssetAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  assignments       AssetAssignment[]
  tickets           Ticket[]
  maintenances      AssetMaintenance[]
  warrantyReminders AssetWarrantyReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([warrantyUntil, status])
  @@map("Assets")
}

model AssetMaintenance {
  id            Int                    @id @default(autoincrement())
  assetId       Int
  asset         Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  title         String                 @db.VarChar(150)
  kind          AssetMaintenanceKind   @default(MAINTENANCE)
  status        AssetMaintenanceStatus @default(PLANNED)
  scheduledFor  DateTime               @db.Date
  performedOn   DateTime?              @db.Date
  vendor        String?                @db.VarChar(150)
  cost          Decimal?               @db.Decimal(12, 0)
  notes         String?                @db.Text
  version       Int                    @default(0)
  createdById   Int
  createdBy     User                   @relation("AssetMaintenanceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completedById Int?
  completedBy   User?                  @relation("AssetMaintenanceCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  completedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([assetId, scheduledFor, id])
  @@index([status, scheduledFor])
  @@index([createdById])
  @@index([completedById])
  @@map("Asset_maintenances")
}

// Durable deduplication survives outbox retention cleanup and multiple workers.
model AssetWarrantyReminder {
  assetId      Int
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  warrantyDate DateTime @db.Date
  createdAt    DateTime @default(now())

  @@id([assetId, warrantyDate])
  @@map("Asset_warranty_reminders")
}

model AssetAssignment {
  id Int @id @default(autoincrement())

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  assignedToId Int
  assignedTo   User @relation("AssetAssignmentsReceived", fields: [assignedToId], references: [id])

  assignedById Int
  assignedBy   User @relation("AssetAssignmentsCreated", fields: [assignedById], references: [id])

  assignedAt DateTime  @default(now())
  returnedAt DateTime?

  returnNotes String? @db.Text

  @@index([assetId])
  @@index([assignedToId])
  @@index([assignedById])
  @@index([returnedAt])
  @@map("Asset_assignments")
}

model AuditLog {
  id Int @id @default(autoincrement())

  actorId Int?
  actor   User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  entity   AuditLogEntity
  entityId Int?

  action      AuditLogAction
  description String         @db.VarChar(500)

  oldValues Json?
  newValues Json?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("Audit_logs")
}

model PasswordResetToken {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @db.Char(64)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("Password_reset_tokens")
}
