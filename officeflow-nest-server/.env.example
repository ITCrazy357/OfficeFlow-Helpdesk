PORT=5001
NODE_ENV=development
# Separate exact non-loopback frontend origins with commas.
# Development loopback origins (localhost, 127.0.0.1, ::1) are allowed automatically.
FRONTEND_URL=http://localhost:3000
# Set to 1 only when the API is behind a trusted reverse proxy.
TRUST_PROXY=0

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=officeflow_helpdesk
MYSQL_USER=officeflow_user
MYSQL_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=mysql://officeflow_user:replace-with-a-url-encoded-password@localhost:3307/officeflow_helpdesk
# Used by docker-compose.nest.yml, where the database is reached by service name.
DOCKER_DATABASE_URL=mysql://officeflow_user:replace-with-a-url-encoded-password@mysql:3306/officeflow_helpdesk

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes

# Required for ticket attachment uploads.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Required only by `npm run prisma:seed`. Existing user passwords are preserved.
SEED_DEFAULT_PASSWORD=replace-with-a-strong-seed-password
# Keep disabled unless the target production database was explicitly verified.
ALLOW_PRODUCTION_SEED=0
# Keep disabled unless a non-local database target was explicitly verified.
ALLOW_REMOTE_SEED=0

MAIL_ENABLED=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password

MAIL_FROM="OfficeFlow Helpdesk <your_email@gmail.com>"
